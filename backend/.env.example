# Example configuration for the DermaCare AI authentication backend.
# Copy this file to .env and replace the placeholder values before starting.
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/dermacare?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_URL=http://localhost:3000

# Email OTP through Gmail: enable 2-Step Verification and create an App Password.
# Never use your normal Gmail password or commit the real values to GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_FROM=DermaCare AI <your-email@gmail.com>

# Optional phone OTP through Twilio. Configure all three values to enable SMS.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+12345678900
